# User data (normally in %LOCALAPPDATA%\SwipeBuddy, ignored here too for dev runs)
config.json
stats.json
browser-profile/
models/
logs/
*.log
.env
.env.*

# Model weights
*.onnx
*.pt
*.gguf
*.safetensors

# Build output
dist/
build/
*.egg-info/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.personal-words

# Images/screenshots (the app keeps profile images in RAM only; these guard
# against debug dumps). assets/ is the only place images may be committed.
screenshots/
captures/
debug_images/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
!assets/*.png
!assets/*.ico

# Packaged builds and archives
*.exe
*.zip

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
